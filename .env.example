# Copy to .env and edit. Every value shown is the default.

# --- Data Fabric cluster -----------------------------------------------------
DF_HOST=df01.kayalab.uk
DF_USER=mapr
DF_PASSWORD=mapr

# Ports, if your cluster differs from a default install.
#DF_REST_PORT=8443
#DF_S3_PORT=9000
#DF_CLDB_PORT=7222
#DF_ZK_PORT=5181

#DF_VERIFY_TLS=false

# --- Per-side overrides ------------------------------------------------------
# Any DF_* name can be prefixed with HQ_ or EDGE_ to override just that side. Leave
# them unset and both sides use the DF_* values above, which is the single-cluster
# case: the two sites are still fully separate, they just share a cluster.
#EDGE_DF_USER=mapr
#EDGE_DF_PASSWORD=mapr

# --- Splitting HQ and edge across two clusters -------------------------------
# Needs a trust relationship between them; nothing else about the design changes.
#EDGE_DF_HOST=df02.kayalab.uk

# --- Object names ------------------------------------------------------------
# Defaults are satellite-hq / satellite-edge volumes, hq-* / edge-* streams and
# buckets. Override if they would collide on a shared cluster.
#APP_NAME=satellite
#HQ_VOLUME_NAME=satellite-hq
#EDGE_VOLUME_NAME=satellite-edge

# --- Cluster truststore (required for a secure cluster) ----------------------
# Copy /opt/mapr/conf/ssl_truststore from any cluster node. Bind-mount it via
# docker-compose, or pass it here when your Docker context is a remote host:
#MAPR_TRUSTSTORE_B64=

# --- Host ports --------------------------------------------------------------
# Only needed if 3000/3001 are already in use on the Docker host.
#HQ_HOST_PORT=3000
#EDGE_HOST_PORT=3001

# --- Presentation ------------------------------------------------------------
#FEED_INTERVAL=12     # seconds between feed injections
#FEED_BATCH=2         # assets published per interval
#COLUMN_LIMIT=8       # tiles kept per stage column

# --- Vision model (optional) -------------------------------------------------
# Also settable in the UI via the "Vision model" button.
#AI_ENDPOINT=http://localhost:8080/v1
#AI_MODEL=llava-v1.5
