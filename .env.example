# Copy to .env and edit. Every value shown is the default.

# --- Data Fabric cluster -----------------------------------------------------
DF_HOST=df01.kayalab.uk
DF_USER=mapr
DF_PASSWORD=mapr

# Ports, if your cluster differs from a default install.
#DF_REST_PORT=8443
#DF_KAFKA_PORT=9092
#DF_S3_PORT=9000

# The Kafka gateway accepts SASL_PLAINTEXT on a default install, which sends the
# password in clear over the network. Set SASL_SSL once the gateway is configured
# for TLS.
#DF_KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
#DF_VERIFY_TLS=false

# --- Per-side users ----------------------------------------------------------
# Any DF_* name can be prefixed with HQ_ or EDGE_ to override just that side.
#
# HQ and the edge should authenticate as DIFFERENT cluster users, because the Kafka
# Wire Protocol maps a topic name to one stream per user. Each user's rule in
# kafka-cluster.conf sends the same satellite_* topics to that side's own stream:
#
#   kafka.cluster.topic-mappings.user-rules.mapr    = ["satellite_*:/apps/satellite/hq_stream"]
#   kafka.cluster.topic-mappings.user-rules.satedge = ["satellite_*:/apps/satellite/edge/edge_stream"]
#
#EDGE_DF_USER=satedge
#EDGE_DF_PASSWORD=

# --- Splitting the demo across two clusters ----------------------------------
#EDGE_DF_HOST=df02.kayalab.uk

# --- Presentation ------------------------------------------------------------
#FEED_INTERVAL=12     # seconds between feed injections
#FEED_BATCH=2         # assets published per interval
#COLUMN_LIMIT=8       # tiles kept per stage column

# --- Vision model (optional) -------------------------------------------------
# Also settable in the UI via the "Vision model" button.
#AI_ENDPOINT=http://localhost:8080/v1
#AI_MODEL=llava-v1.5
