# Copy to .env and edit. Commented values show the default.
#
#   cp .env.example .env
#
# Everything here is optional. With an empty file the demo still starts and you point
# it at a cluster from the interface — which is the easiest way to try it.

# --- Headquarters cluster ----------------------------------------------------
# A hostname where CLDB (7222), the apiserver (8443), S3 (9000), ZooKeeper (5181)
# and NFS (2049) are all reachable.
#HQ_HOST=
#HQ_USER=mapr
#HQ_PASSWORD=mapr

# --- Edge cluster ------------------------------------------------------------
# Point this at the same host as HQ if you only have one cluster. The two sites stay
# fully separate — different volumes, streams and buckets — so the demo behaves the
# same either way. A second cluster needs a trust relationship between them.
#EDGE_HOST=
#EDGE_USER=mapr
#EDGE_PASSWORD=mapr

# Ports, if your cluster differs from a default install.
#HQ_REST_PORT=8443
#HQ_S3_PORT=9000
#HQ_CLDB_PORT=7222
#HQ_ZK_PORT=5181
#EDGE_REST_PORT=8443
#EDGE_S3_PORT=9000

# Normally discovered from the cluster; set only if that lookup fails.
#HQ_CLUSTER_NAME=

# --- Cluster truststore (needed once you connect a cluster) -------------------
# A secure cluster will not authenticate without it, and it cannot be generated.
# Copy /opt/mapr/conf/ssl_truststore from any cluster node, then:
#
#   MAPR_TRUSTSTORE_B64=$(base64 -w0 ssl_truststore)      # Linux
#   MAPR_TRUSTSTORE_B64=$(base64 -i  ssl_truststore)      # macOS
#
# This works whether your Docker context is local or a remote host. If it is local you
# may instead bind-mount the file — see docker-compose.yaml.
#MAPR_TRUSTSTORE_B64=

# --- Interface ---------------------------------------------------------------
# Published on the Docker host. If your Docker context points at a remote machine,
# the interface is on that machine's address, not your localhost.
#PORT=8080

# --- Building the image ------------------------------------------------------
# HPE's public package repository requires credentials. Point these at a mirror you can
# reach, and match your cluster's version — a client older than the cluster cannot
# authenticate to it.
#MAPR_REPO=https://package.ezmeral.hpe.com/releases/v8.1.0/redhat
#MAPR_MEP_REPO=https://package.ezmeral.hpe.com/releases/MEP/MEP-10.1.0/redhat

# --- Object names ------------------------------------------------------------
# Defaults are satellite-hq / satellite-edge volumes with hq-* / edge-* streams and
# buckets. Override if they would collide on a shared cluster.
#APP_NAME=satellite
#HQ_VOLUME_NAME=satellite-hq
#EDGE_VOLUME_NAME=satellite-edge

# --- Presentation ------------------------------------------------------------
#FEED_INTERVAL=12     # seconds between feed injections
#FEED_BATCH=2         # assets published per interval
#COLUMN_LIMIT=8       # tiles kept per stage column

# --- Vision model (optional) -------------------------------------------------
# Narration is optional; the pipeline runs without it. Also settable in the interface.
#AI_ENDPOINT=http://your-model-host:8080/v1
#AI_MODEL=llava-v1.5
